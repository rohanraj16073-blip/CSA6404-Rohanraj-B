
import re
from collections import Counter

# Sample raw log lines
raw_logs = [
    "2026-10-12 10:15:20 INFO 192.168.1.10 User login successful",
    "2026-10-12 10:16:05 ERROR 192.168.1.20 Database connection failed",
    "2026-10-12 10:17:10 WARNING 192.168.1.10 Multiple login attempts",
    "2026-10-12 10:18:25 INFO 192.168.1.30 File downloaded",
    "2026-10-12 10:19:40 ERROR 192.168.1.20 Authentication failed"
]


# 1. Logstash-style parsing
def parse_logs(logs):
    events = []

    pattern = (
        r"(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}) "
        r"(INFO|ERROR|WARNING) "
        r"(\d{1,3}(?:\.\d{1,3}){3}) "
        r"(.+)"
    )

    for log in logs:
        match = re.match(pattern, log)

        if match:
            event = {
                "timestamp": match.group(1),
                "level": match.group(2),
                "ip": match.group(3),
                "message": match.group(4)
            }
            events.append(event)
        else:
            print("Invalid log format:", log)

    return events


# 2. Elasticsearch-style indexing
def index_events(events):
    index = {}

    for event_id, event in enumerate(events, start=1):
        index[event_id] = event

    return index


# 3. Kibana-style aggregation
def aggregate_events(index):
    level_counts = Counter()
    ip_counts = Counter()

    for event in index.values():
        level_counts[event["level"]] += 1
        ip_counts[event["ip"]] += 1

    print("\n--- Kibana-Style Log Dashboard ---")

    print("\nEvents by Log Level:")
    for level, count in sorted(level_counts.items()):
        print(f"{level}: {count}")

    print("\nEvents by IP Address:")
    for ip, count in sorted(ip_counts.items()):
        print(f"{ip}: {count}")

    print("\nTotal Events:", len(index))


# Main program
print("=== ELK Stack Simulation ===")

structured_events = parse_logs(raw_logs)

print("\n--- Logstash-Style Parsing ---")
for event in structured_events:
    print(event)

indexed_events = index_events(structured_events)

print("\n--- Elasticsearch-Style Index ---")
for event_id, event in indexed_events.items():
    print(f"Document {event_id}: {event}")

aggregate_events(indexed_events)
